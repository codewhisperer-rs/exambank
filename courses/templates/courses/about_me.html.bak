<!DOCTYPE html>
<html lang="zh-hans">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>关于我们 - 计算机考研题库</title>
    <!-- 引入Bootstrap CSS -->
    <link href="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <!-- 引入Bootstrap图标 -->
    <link href="https://cdn.bootcdn.net/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        .navbar-brand img {
            height: 40px;
        }
        .hero-section {
            background-color: #f8f9fa;
            padding: 60px 0;
        }
        .card {
            transition: transform 0.2s;
            margin-bottom: 20px;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        /* 控制图片大小 */
        img {
            max-width: 100%;
            height: auto;
        }
        /* 让退出按钮看起来像普通链接 */
        .btn-link.nav-link {
            padding: 0.5rem 1rem;
            background: none;
            border: none;
            text-decoration: none;
            color: rgba(0,0,0,.55);
            cursor: pointer;
        }
        .btn-link.nav-link:hover {
            color: rgba(0,0,0,.7);
        }
        /* 页脚样式 */
        footer {
            margin-top: 3rem;
            padding: 2rem 0;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <!-- 导航栏 -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="{% url 'home' %}">
                <i class="bi bi-book"></i> 计算机考研题库
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'courses:index' %}">课程首页</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    {% if user.is_authenticated and not is_anonymous_view %}
                    <li class="nav-item">
                        <span class="nav-link">您好，{{ user.username }}</span>
                    </li>
                    <li class="nav-item">
                        <form method="post" action="{% url 'logout' %}" class="d-inline">
                            {% csrf_token %}
                            <button type="submit" class="btn btn-link nav-link">退出</button>
                        </form>
                    </li>
                    {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'login' %}?next=/courses/">登录</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'register' %}">注册</a>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- 主要内容 -->
    <main class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-lg border-0 rounded-lg">
                    <div class="card-header bg-primary text-white">
                        <h1 class="text-center mb-0">关于我们</h1>
                    </div>
                    <div class="card-body">
                        <!-- 视频部分 -->
                        <div class="ratio ratio-16x9 mb-5">
                            <!-- 视频源 -->
                            <video controls class="rounded shadow">
                                <source src="{{ MEDIA_URL }}videos/intro.mp4" type="video/mp4">
                                您的浏览器不支持视频播放，请升级您的浏览器或使用其他浏览器。
                            </video>
                        </div>
                        
                        <!-- 内容介绍部分 -->
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body">
                                        <h3 class="card-title border-bottom pb-3">
                                            <i class="bi bi-book-half text-primary me-2"></i>我们的使命
                                        </h3>
                                        <p class="card-text">
                                            计算机考研题库项目旨在为计算机专业考研学生提供高质量的学习资源和练习平台。我们致力于收集、整理和提供各大高校计算机专业研究生入学考试的真题和模拟题，帮助考生更好地备战考研。
                                        </p>
                                        <p class="card-text">
                                            通过智能推荐系统和个性化学习路径，我们希望每位学生都能找到适合自己的学习方法，提高学习效率，实现考研目标。
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body">
                                        <h3 class="card-title border-bottom pb-3">
                                            <i class="bi bi-lightbulb text-primary me-2"></i>特色功能
                                        </h3>
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item border-0">
                                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                                <strong>知识图谱</strong>：直观展示计算机专业知识体系
                                            </li>
                                            <li class="list-group-item border-0">
                                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                                <strong>错题集</strong>：智能记录您的错题，辅助记忆和复习
                                            </li>
                                            <li class="list-group-item border-0">
                                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                                <strong>AI推荐</strong>：根据学习情况智能推荐练习题
                                            </li>
                                            <li class="list-group-item border-0">
                                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                                <strong>AI助教</strong>：解答问题，提供学习指导
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <h3 class="card-title border-bottom pb-3">
                                            <i class="bi bi-people-fill text-primary me-2"></i>我们的团队
                                        </h3>
                                        <p class="card-text">
                                            我们的团队由西南大学计算机与信息科学学院的教师和学生组成。团队成员熟悉计算机专业考研要求和考试内容，对教育领域充满热情。我们不断探索创新教育方式，结合人工智能技术，为学生提供更好的学习体验。
                                        </p>
                                        <div class="row mt-4">
                                            <div class="col-md-4 text-center mb-3">
                                                <div class="bg-light rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                                    <i class="bi bi-person-fill text-primary" style="font-size: 3rem;"></i>
                                                </div>
                                                <h5>王教授</h5>
                                                <p class="text-muted">项目指导</p>
                                            </div>
                                            <div class="col-md-4 text-center mb-3">
                                                <div class="bg-light rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                                    <i class="bi bi-person-fill text-primary" style="font-size: 3rem;"></i>
                                                </div>
                                                <h5>李博士</h5>
                                                <p class="text-muted">技术负责人</p>
                                            </div>
                                            <div class="col-md-4 text-center mb-3">
                                                <div class="bg-light rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                                    <i class="bi bi-person-fill text-primary" style="font-size: 3rem;"></i>
                                                </div>
                                                <h5>张同学</h5>
                                                <p class="text-muted">开发工程师</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light py-3">
                        {% if user.is_authenticated and not is_anonymous_view %}
                        <!-- 已登录用户，但我们要显示未登录状态 -->
                        {% endif %}
                        <div class="text-center">
                            <a href="{% url 'login' %}?next=/courses/" class="btn btn-primary btn-lg me-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i>登录系统
                            </a>
                            <a href="{% url 'register' %}" class="btn btn-outline-primary btn-lg">
                                <i class="bi bi-person-plus me-1"></i>注册账号
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- 页脚 -->
    <footer class="bg-light py-4">
        <div class="container text-center">
            <p class="mb-0">© 西南大学计算机与信息科学学院Lab808. All rights reserved.</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>